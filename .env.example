# Database URL: defaults to SQLite for local development; set to PostgreSQL for production
DATABASE_URL=sqlite:///./curriculum_gap.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/curriculum_gap

# NLP Semantic Embedding Model Identifier
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# API Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
